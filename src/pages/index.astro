---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import EditorialRow from '../components/EditorialRow.astro';
import BirthdayOverlay from '../components/BirthdayOverlay.astro';

const signatures = [
  { href: '/menu/jollof', image: '/images/jollof.jpg', name: 'Jollof rice', tag: 'The house signature', alt: 'Cups of smoky jollof rice topped with chicken and suya' },
  { href: '/menu/fire-feast-x', image: '/images/fire-feast-x.jpg', name: 'Fire Feast X', tag: 'Served in a pineapple', alt: 'Fried rice with shrimp and peppers served inside a pineapple' },
  { href: '/menu/fruity-zobo', image: '/images/fruity-zobo.jpg', name: 'Fruity Zobo', tag: 'The signature drink', alt: 'Two bottles of Rheetah\'s Fruity Zobo held up on a Lagos rooftop' },
];

const gallery = [
  { image: '/images/big-pot.jpg', alt: 'Rita cooking at the big pots' },
  { image: '/images/box-bamboo.jpg', alt: 'A bamboo tray of jollof cups and small chops' },
  { image: '/images/team.jpg', alt: "The Rheetah's Kitchen crew at the GTCO stand" },
  { image: '/images/small-chops.jpg', alt: 'A tray of small chops' },
  { image: '/images/kitchen-packing.jpg', alt: 'Packing a meal box by hand' },
];
---

<Base
  title="Rheetah's Kitchen — Love at first bite"
  description="Rheetah's Kitchen is a Lagos food brand by Rita Mensah. Jollof, Fire Feast X and Fruity Zobo. Catering, events, and a Guinness World Records cook-a-thon attempt in honour of her mother."
>
  <!-- HERO -->
  <section class="hero" aria-label="Rheetah's Kitchen">
    <video class="hero__video" autoplay muted loop playsinline poster="/video/hero-poster.jpg" preload="metadata" aria-hidden="true">
      <source src="/video/hero.webm" type="video/webm" />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero__scrim"></div>
    <div class="wrap hero__inner">
      <span class="eyebrow hero__eyebrow">Lagos · Est. 2021</span>
      <h1 class="hero__title"><em>Love at first bite.</em></h1>
      <p class="hero__sub">Rheetah's Kitchen · a Lagos food brand by Rita Mensah</p>
      <div class="hero__cta">
        <a href="/menu" class="btn btn--cream">See the menu <span class="arw">→</span></a>
        <a href="/contact" class="btn btn--line hero__ghost">Book Chef Rheetah <span class="arw">→</span></a>
      </div>
    </div>
  </section>

  <Ticker />

  <!-- INTRO -->
  <section class="section intro">
    <div class="wrap intro__inner" data-reveal>
      <span class="eyebrow intro__eyebrow">Rheetah's Kitchen</span>
      <p class="intro__lead">
        Rita Mensah runs Rheetah's Kitchen out of Lagos. What began at university in 2019 became a
        brand in 2021, built in honour of her mother, a caterer before her. Jollof. Fire Feast X.
        Fruity Zobo. Love at first bite.
      </p>
      <a href="/story" class="arrow-link intro__link">Read her story <span class="arw">→</span></a>
    </div>
  </section>

  <!-- MEET RITA -->
  <EditorialRow
    image="/images/portrait.jpg"
    alt="Chef Rita Mensah in her chef whites"
    eyebrow="In honour"
    title="A kitchen built in her mother's honour."
    body={[
      'Rita’s late mother was a caterer and food vendor. The way she fed people stayed with Rita.',
      'Rheetah’s Kitchen is built in her honour, and in Rita’s own love for food.',
    ]}
    href="/story"
    cta="Read her story"
    side="left"
    ground="cream"
    blob={true}
  />

  <!-- SIGNATURES (continuous triptych) -->
  <section class="sigs">
    <div class="wrap sigs__head" data-reveal>
      <span class="eyebrow eyebrow--gold">Signatures</span>
      <h2 class="sigs__title">Three plates she's known for.</h2>
      <a href="/menu" class="arrow-link sigs__all">See the full menu <span class="arw">→</span></a>
    </div>
    <div class="sigs__strip">
      {signatures.map((s) => (
        <a class="sig" href={s.href} data-reveal>
          <img src={s.image} alt={s.alt} loading="lazy" class="sig__img" />
          <span class="sig__scrim"></span>
          <span class="sig__cap">
            <span class="sig__tag">{s.tag}</span>
            <span class="sig__name">{s.name}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- CATERING -->
  <EditorialRow
    image="/images/catering.jpg"
    alt="A catered spread of jollof, fried rice, spaghetti and proteins in trays"
    eyebrow="Catering & events"
    title="From single-serves for 80 to full spreads."
    body={['Trays, buffets, cocktail tables and lunch packs. Cooked to order and packed by hand.']}
    href="/catering"
    cta="See catering"
    side="right"
    ground="sand"
  />

  <!-- GTCO -->
  <EditorialRow
    image="/images/festival.jpg"
    alt="The Rheetah's Kitchen stand at the GTCO Food and Drink Festival"
    eyebrow="Featured vendor"
    title="Sold out three days at GTCO 2026."
    body={['One of 204 vendors selected for the GTCO Food & Drink Festival. The stand was complimentary. She sold out three days running.']}
    href="/gtco"
    cta="The festival story"
    side="left"
    ground="cream"
    eyebrowClass="eyebrow--gold"
  />

  <!-- GWR (on the homepage, links to full page) -->
  <EditorialRow
    image="/images/big-pot.jpg"
    alt="Rita cooking at the big pots"
    eyebrow="What's next"
    title="A Guinness World Records cook-a-thon attempt. In honour."
    body={[
      'Rita is planning a Guinness World Records cook-a-thon attempt.',
      'Food cooked on the day is shared with everyone there and donated to charity partners across Lagos, in honour of her mother’s legacy.',
    ]}
    href="/gwr"
    cta="Read more"
    side="right"
    ground="brown"
    blob={true}
    blobColor="var(--gold)"
  />

  <!-- GALLERY strip -->
  <section class="gal">
    <div class="wrap gal__head" data-reveal>
      <span class="eyebrow eyebrow--gold">Gallery</span>
      <h2 class="gal__title">Dishes, boxes, and the stand.</h2>
      <a href="/gallery" class="arrow-link gal__all">See the gallery <span class="arw">→</span></a>
    </div>
    <div class="gal__strip">
      {gallery.map((g) => (
        <a href="/gallery" class="gal__cell" data-reveal>
          <img src={g.image} alt={g.alt} loading="lazy" />
        </a>
      ))}
    </div>
  </section>

  {/* July 10 only — isolated overlay, leaves no trace the rest of the year */}
  <BirthdayOverlay />
</Base>

<style>
  /* HERO */
  .hero { position: relative; min-height: min(92vh, 780px); display: grid; align-items: end; overflow: hidden; background: var(--brown-deep); }
  .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(42,22,7,0.55) 0%, rgba(42,22,7,0.12) 26%, rgba(42,22,7,0.42) 60%, rgba(42,22,7,0.9) 100%);
  }
  .hero__inner { position: relative; z-index: 2; padding-block: clamp(40px, 8vh, 84px); }
  .hero__eyebrow { color: var(--gold-soft); }
  .hero__title { color: var(--cream); font-size: var(--fs-hero); line-height: 0.98; letter-spacing: -0.02em; margin-top: 16px; max-width: 15ch; text-shadow: 0 2px 30px rgba(0,0,0,0.3); }
  .hero__sub { color: color-mix(in srgb, var(--cream) 90%, transparent); font-size: clamp(15px, 3.4vw, 19px); font-family: var(--serif); margin-top: 18px; max-width: 34ch; text-shadow: 0 1px 16px rgba(0,0,0,0.4); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .hero__ghost { color: var(--cream); border-color: rgba(247,241,232,0.5); }
  .hero__ghost:hover { background: var(--cream); color: var(--brown); border-color: var(--cream); }

  /* INTRO */
  .intro { background: var(--cream); }
  .intro__inner { max-width: 640px; margin-inline: auto; text-align: center; }
  .intro__eyebrow { color: var(--gold); }
  .intro__lead { font-family: var(--serif); font-size: clamp(22px, 3vw, 30px); line-height: 1.4; color: var(--brown); margin-top: 18px; }
  .intro__link { margin-top: 26px; }

  /* SIGNATURES triptych */
  .sigs { background: var(--cream); padding-top: var(--section-py); }
  .sigs__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 24px; margin-bottom: clamp(24px, 4vh, 40px); }
  .sigs__title { font-size: var(--fs-h2); flex: 1 1 auto; margin-top: 6px; }
  .sigs__all { flex-shrink: 0; }
  .sigs__strip { display: grid; grid-template-columns: 1fr; gap: 0; }
  .sig { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; }
  .sig__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .sig:hover .sig__img { transform: scale(1.05); }
  .sig__scrim { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(42,22,7,0.82) 0%, rgba(42,22,7,0.1) 48%, transparent 100%); }
  .sig__cap { position: absolute; left: 0; right: 0; bottom: 0; padding: clamp(20px, 2vw, 30px); display: flex; flex-direction: column; gap: 4px; }
  .sig__tag { font-size: var(--fs-eyebrow); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-soft); }
  .sig__name { font-family: var(--serif); font-style: italic; font-size: var(--fs-h2); color: var(--cream); }
  @media (min-width: 760px) { .sigs__strip { grid-template-columns: repeat(3, 1fr); } .sig { aspect-ratio: 4 / 5; } }

  /* GALLERY strip */
  .gal { background: var(--bone); padding-top: var(--section-py); padding-bottom: 0; }
  .gal__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 24px; margin-bottom: clamp(24px, 4vh, 40px); }
  .gal__title { font-size: var(--fs-h2); flex: 1 1 auto; margin-top: 6px; }
  .gal__all { flex-shrink: 0; }
  .gal__strip { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; }
  .gal__cell { overflow: hidden; aspect-ratio: 1 / 1; }
  .gal__cell img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .gal__cell:hover img { transform: scale(1.05); }
  @media (min-width: 760px) { .gal__strip { grid-template-columns: repeat(5, 1fr); } }
</style>

<script>
  const v = document.querySelector('.hero__video') as HTMLVideoElement | null;
  if (v) {
    const tryPlay = () => v.play().catch(() => {});
    if (v.readyState >= 2) tryPlay();
    v.addEventListener('canplay', tryPlay, { once: true });
  }
</script>
