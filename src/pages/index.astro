---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import Card from '../components/Card.astro';
import GwrBand from '../components/GwrBand.astro';

const doors = [
  {
    href: '/menu',
    image: '/images/jollof.jpg',
    alt: 'Cups of jollof rice topped with chicken and suya',
    eyebrow: 'Signatures',
    title: 'The menu',
    desc: 'Jollof, Fire Feast X, Fruity Zobo.',
  },
  {
    href: '/catering',
    image: '/images/catering.jpg',
    alt: 'A catered spread of rice, proteins and sides in trays',
    eyebrow: 'Catering & events',
    title: 'Catering',
    desc: 'From single-serves for 80 to full spreads.',
  },
  {
    href: '/gtco',
    image: '/images/festival.jpg',
    alt: "The Rheetah's Kitchen stand at the GTCO Food and Drink Festival",
    eyebrow: 'The festival',
    title: 'GTCO 2026',
    desc: 'Sold out three days at GTCO 2026.',
  },
  {
    href: '/gwr',
    image: '/images/portrait.jpg',
    alt: 'Chef Rita Mensah in her chef whites',
    eyebrow: 'In honour',
    title: "What's next",
    desc: 'A Guinness World Records cook-a-thon attempt.',
  },
];
---

<Base
  title="Rheetah's Kitchen — Love at first bite"
  description="Rheetah's Kitchen is a Lagos food brand by Rita Mensah. Jollof, Fire Feast X and Fruity Zobo. Catering, events, and a Guinness World Records cook-a-thon attempt in honour of her mother."
>
  <!-- HERO -->
  <section class="hero" aria-label="Rheetah's Kitchen">
    <video
      class="hero__video"
      autoplay muted loop playsinline
      poster="/video/hero-poster.jpg"
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/video/hero.webm" type="video/webm" />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero__scrim"></div>
    <div class="wrap hero__inner">
      <span class="eyebrow hero__eyebrow">Lagos · Est. 2021</span>
      <h1 class="hero__title"><em>Love at first bite.</em></h1>
      <p class="hero__sub">Rheetah's Kitchen · a Lagos food brand by Rita Mensah</p>
      <div class="hero__cta">
        <a href="/menu" class="btn btn--cream">See the menu <span class="arw">→</span></a>
        <a href="/contact" class="btn btn--line hero__ghost">Book Chef Rheetah <span class="arw">→</span></a>
      </div>
    </div>
  </section>

  <Ticker />

  <!-- INTRO -->
  <section class="section intro">
    <div class="wrap intro__inner" data-reveal>
      <span class="eyebrow intro__eyebrow">Rheetah's Kitchen</span>
      <p class="intro__lead">
        Rita Mensah runs Rheetah's Kitchen out of Lagos. What began at university in 2019 became a
        brand in 2021, built in honour of her mother, a caterer before her. Jollof. Fire Feast X.
        Fruity Zobo. Love at first bite.
      </p>
      <a href="/story" class="arrow-link intro__link">Read her story <span class="arw">→</span></a>
    </div>
  </section>

  <!-- DOORWAY CARDS -->
  <section class="section doors">
    <div class="wrap">
      <div class="doors__head" data-reveal>
        <span class="eyebrow eyebrow--gold">Explore</span>
        <h2 class="doors__title">Where to start.</h2>
      </div>
      <div class="doors__grid">
        {doors.map((d, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <Card
              href={d.href}
              image={d.image}
              alt={d.alt}
              eyebrow={d.eyebrow}
              title={d.title}
              desc={d.desc}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <GwrBand />
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: min(92vh, 780px);
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--brown-deep);
  }
  .hero__video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero__scrim {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, rgba(42,22,7,0.55) 0%, rgba(42,22,7,0.12) 26%, rgba(42,22,7,0.42) 60%, rgba(42,22,7,0.9) 100%);
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(40px, 8vh, 84px);
  }
  .hero__eyebrow { color: var(--gold-soft); }
  .hero__title {
    color: var(--cream);
    font-size: var(--fs-hero);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-top: 16px;
    max-width: 15ch;
    text-shadow: 0 2px 30px rgba(0,0,0,0.3);
  }
  .hero__sub {
    color: color-mix(in srgb, var(--cream) 90%, transparent);
    font-size: clamp(15px, 3.4vw, 19px);
    font-family: var(--serif);
    margin-top: 18px;
    max-width: 34ch;
    text-shadow: 0 1px 16px rgba(0,0,0,0.4);
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .hero__ghost { color: var(--cream); border-color: rgba(247,241,232,0.5); }
  .hero__ghost:hover { background: var(--cream); color: var(--brown); border-color: var(--cream); }

  /* INTRO */
  .intro { background: var(--cream); }
  .intro__inner { max-width: 640px; margin-inline: auto; text-align: center; }
  .intro__eyebrow { color: var(--gold); }
  .intro__lead {
    font-family: var(--serif);
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.4;
    color: var(--brown);
    margin-top: 18px;
  }
  .intro__link { margin-top: 26px; }

  /* DOORS */
  .doors { background: var(--cream); padding-top: 0; }
  .doors__head { margin-bottom: clamp(28px, 4vh, 44px); }
  .doors__title { font-size: var(--fs-h2); margin-top: 12px; }
  .doors__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .doors__grid { grid-template-columns: 1fr 1fr; gap: 16px; }
  }
</style>

<script>
  const v = document.querySelector('.hero__video') as HTMLVideoElement | null;
  if (v) {
    const tryPlay = () => v.play().catch(() => {});
    if (v.readyState >= 2) tryPlay();
    v.addEventListener('canplay', tryPlay, { once: true });
  }
</script>
