<script>
  // Ensure hero video plays on iOS/low-power where autoplay may stall
  const v = document.querySelector('.hero__video') as HTMLVideoElement | null;
  if (v) {
    const tryPlay = () => v.play().catch(() => {});
    if (v.readyState >= 2) tryPlay();
    v.addEventListener('canplay', tryPlay, { once: true });
  }
</script>
