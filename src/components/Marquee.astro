---
interface Props {
  items: string[];
  speed?: number; // seconds per loop
  tone?: 'orange' | 'brown';
}
const { items, speed = 30, tone = 'orange' } = Astro.props;
const doubled = [...items, ...items, ...items, ...items];
---

<div class:list={['marquee', `marquee--${tone}`]} aria-hidden="true">
  <div class="marquee__track" style={`--speed:${speed}s`}>
    {doubled.map((item) => (
      <span class="marquee__item">
        {item}
        <span class="marquee__dot">✦</span>
      </span>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    white-space: nowrap;
    padding-block: clamp(0.85rem, 2vw, 1.35rem);
  }
  .marquee--orange { background: var(--orange); color: var(--brown-deep); }
  .marquee--brown { background: var(--brown-deep); color: var(--cream); }
  .marquee__track {
    display: inline-flex;
    align-items: center;
    animation: marquee var(--speed) linear infinite;
    will-change: transform;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1rem + 1.7vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    padding-inline: 0.55em;
  }
  .marquee--orange .marquee__dot { color: var(--cream); }
  .marquee--brown .marquee__dot { color: var(--orange); }
  .marquee__dot {
    font-size: 0.55em;
    margin-inline-start: 1.1em;
    transform: translateY(-0.1em);
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; transform: none; }
    .marquee { text-align: center; }
  }
</style>
