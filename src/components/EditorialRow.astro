---
import Blob from './Blob.astro';

interface Props {
  eyebrow?: string;
  title: string;
  body?: string[];
  image: string;
  alt: string;
  href?: string;
  cta?: string;
  side?: 'left' | 'right'; // which side the image sits on (desktop)
  ground?: 'cream' | 'sand' | 'bone' | 'brown';
  blob?: boolean;
  blobColor?: string;
  eyebrowClass?: string;
}
const {
  eyebrow,
  title,
  body = [],
  image,
  alt,
  href,
  cta = 'View',
  side = 'right',
  ground = 'cream',
  blob = false,
  blobColor = 'var(--gold)',
  eyebrowClass = '',
} = Astro.props;
---

<section class:list={['erow', `erow--${ground}`]} data-side={side} data-reveal>
  {blob && (
    <Blob color={blobColor} opacity={ground === 'brown' ? 0.16 : 0.12} size="min(52vw, 460px)"
      {...(side === 'right' ? { left: '-6%' } : { right: '-6%' })} top="-12%" rotate="12deg" />
  )}
  <div class="wrapfull erow__grid">
    <div class="erow__media">
      <img src={image} alt={alt} loading="lazy" />
    </div>
    <div class="erow__text">
      {eyebrow && <span class:list={['eyebrow', 'erow__eyebrow', eyebrowClass]}>{eyebrow}</span>}
      <h2 class="erow__title">{title}</h2>
      {body.map((p) => <p class="erow__p">{p}</p>)}
      <slot />
      {href && (
        <a href={href} class="arrow-link erow__link">{cta} <span class="arw">→</span></a>
      )}
    </div>
  </div>
</section>

<style>
  .erow { position: relative; overflow: hidden; }
  .erow--cream { background: var(--cream); }
  .erow--sand { background: var(--sand); }
  .erow--bone { background: var(--bone); }
  .erow--brown {
    background:
      radial-gradient(70% 120% at 80% 10%, rgba(200,146,60,0.16) 0%, transparent 60%),
      var(--brown-deep);
    color: var(--cream);
  }
  .wrapfull { width: 100%; }
  .erow__grid { display: grid; grid-template-columns: 1fr; position: relative; z-index: 1; }

  .erow__media { aspect-ratio: 4 / 3; overflow: hidden; }
  .erow__media img { width: 100%; height: 100%; object-fit: cover; }

  .erow__text {
    padding: clamp(34px, 6vw, 84px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0;
  }
  .erow__eyebrow { color: var(--gold); margin-bottom: 16px; }
  .erow--brown .erow__eyebrow { color: var(--gold); }
  .erow__title {
    font-size: var(--fs-h1);
    line-height: 1.05;
    max-width: 18ch;
  }
  .erow--brown .erow__title { color: var(--cream); }
  .erow__p {
    margin-top: 16px;
    color: var(--muted);
    font-size: var(--fs-body);
    max-width: 46ch;
  }
  .erow--brown .erow__p { color: rgba(247,241,232,0.78); }
  .erow__link { margin-top: 26px; align-self: flex-start; }
  .erow--brown .erow__link { color: var(--gold); }

  @media (min-width: 900px) {
    .erow__grid { grid-template-columns: 1fr 1fr; min-height: clamp(460px, 62vh, 640px); }
    .erow__media { aspect-ratio: auto; height: 100%; }
    .erow[data-side='left'] .erow__media { order: 0; }
    .erow[data-side='left'] .erow__text { order: 1; }
    .erow[data-side='right'] .erow__media { order: 1; }
    .erow[data-side='right'] .erow__text { order: 0; }
  }
</style>
