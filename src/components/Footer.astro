---
const year = new Date().getFullYear();
const wa = 'https://wa.me/2349129508724';
const ig = 'https://www.instagram.com/rheetahs_kitchen/';
const explore = [
  { href: '/menu', label: 'Menu' },
  { href: '/story', label: 'Story' },
  { href: '/catering', label: 'Catering' },
];
const more = [
  { href: '/gtco', label: 'GTCO Festival' },
  { href: '/gwr', label: 'The GWR attempt' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__mark" aria-label="Rheetah's Kitchen — home">
        <img src="/images/logo.png" alt="Rheetah's Kitchen" class="footer__logo" width="1003" height="579" />
      </a>
      <p class="footer__tag serif italic">Love at first bite.</p>
    </div>

    <nav class="footer__col" aria-label="Explore">
      <h2 class="footer__h">Explore</h2>
      <ul role="list">{explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav class="footer__col" aria-label="More">
      <h2 class="footer__h">More</h2>
      <ul role="list">{more.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__h">Find us</h2>
      <ul role="list">
        <li><a href={ig} target="_blank" rel="noopener">@rheetahs_kitchen</a></li>
        <li><a href={wa} target="_blank" rel="noopener">+234 912 950 8724</a></li>
        <li class="footer__place">Lagos, Nigeria</li>
      </ul>
    </div>
  </div>

  <div class="wrap footer__base">
    <p>
      Designed and built by
      <a href="https://agtconsults.com/" target="_blank" rel="noopener" class="footer__studio">Alpha Global Tech and Consulting</a>
    </p>
    <p class="footer__legal">© {year} Rheetah's Kitchen</p>
  </div>
</footer>

<style>
  .footer { background: var(--cream); border-top: 1px solid var(--line); }
  .footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 5vw, 56px);
    padding-block: clamp(48px, 7vh, 80px) 40px;
  }
  .footer__logo { height: 44px; width: auto; }
  .footer__tag { margin-top: 18px; font-size: var(--fs-h3); color: var(--brown); }

  .footer__h {
    font-family: var(--sans);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .footer__col ul { display: flex; flex-direction: column; gap: 10px; }
  .footer__col a { color: var(--brown); font-size: var(--fs-small); transition: color 0.3s var(--ease); }
  .footer__col a:hover { color: var(--orange-deep); }
  .footer__place { color: var(--muted); font-size: var(--fs-small); }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 40px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .footer__studio { color: var(--brown); font-weight: 600; border-bottom: 1px solid var(--orange); }
  .footer__studio:hover { color: var(--orange-deep); }

  @media (min-width: 720px) {
    .footer__inner { grid-template-columns: 2fr 1fr 1fr 1.2fr; }
  }
</style>
