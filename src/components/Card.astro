---
interface Props {
  href: string;
  image: string;
  alt: string;
  eyebrow: string;
  title: string;
  desc: string;
  ratio?: string; // e.g. "4 / 3" or "1 / 1"
}
const { href, image, alt, eyebrow, title, desc, ratio = '4 / 3' } = Astro.props;
---

<a class="card" href={href}>
  <div class="card__media" style={`--ratio:${ratio}`}>
    <img src={image} alt={alt} loading="lazy" class="card__img" />
  </div>
  <div class="card__body">
    <span class="eyebrow card__eyebrow">{eyebrow}</span>
    <h3 class="card__title">{title}</h3>
    <p class="card__desc">{desc}</p>
    <span class="card__more">View <span class="arw">→</span></span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bone);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), border-color 0.5s var(--ease);
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: 0 20px 44px -26px rgba(42, 22, 7, 0.4);
  }
  .card__media { aspect-ratio: var(--ratio); overflow: hidden; background: var(--sand); }
  .card__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .card:hover .card__img { transform: scale(1.04); }
  .card__body { padding: clamp(18px, 2vw, 26px); display: flex; flex-direction: column; gap: 8px; }
  .card__eyebrow { color: var(--gold); }
  .card__title { font-size: var(--fs-h3); letter-spacing: -0.005em; }
  .card__desc { font-size: var(--fs-small); color: var(--muted); }
  .card__more {
    margin-top: 6px;
    display: inline-flex; align-items: center; gap: 0.5em;
    font-size: var(--fs-eyebrow);
    font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--brown);
  }
  .card__more .arw { transition: transform 0.35s var(--ease); }
  .card:hover .card__more .arw { transform: translateX(4px); }
  .card:hover .card__more { color: var(--orange-deep); }
</style>
